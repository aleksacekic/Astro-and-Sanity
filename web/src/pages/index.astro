---
import {sanityClient} from '../lib/sanity'
import {pageQuery} from '../lib/queries'
import type {PageData} from '../lib/types'
import DemoSectionRenderer from '../components/DemoSectionRenderer.astro'

const lang = 'sr'
const page: PageData = await sanityClient.fetch(pageQuery, {slug: 'home', lang})
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fokusiraj</title>
    {page?.metaDescription && (
      <meta name="description" content={page.metaDescription} />
    )}
  </head>
  <body>
    <header class="demo-header">
      <a class="demo-skip-link" href="#main">Preskoči na sadržaj</a>
      <nav class="demo-nav" aria-label="Glavna navigacija">
        <a class="demo-nav__logo" href="/">Fokusiraj</a>
      </nav>
    </header>

    <main id="main">
      <DemoSectionRenderer sections={page?.sections ?? []} />
    </main>

    <footer class="demo-footer">
      <p>&copy; {new Date().getFullYear()} Fokusiraj. Demo projekat.</p>
    </footer>
  </body>
</html>