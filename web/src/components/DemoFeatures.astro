---
import type {FeaturesSection} from '../lib/types'
import type {Lang} from '../i18n/ui'
import {useTranslations} from '../i18n/utils'

const {data, lang} = Astro.props as {data: FeaturesSection; lang: Lang}
const t = useTranslations(lang)
const headingId = `features-${data._key}`
// Bez h2 bi stavke (h3) visile direktno ispod h1, a aria-labelledby bi
// pokazivao u prazno. Zato naslov uvek postoji; ako ga urednik nije uneo,
// vidljiv je samo čitačima ekrana.
---

<section class="demo-features" aria-labelledby={headingId}>
  {data.heading ? (
    <h2 class="demo-features__heading" id={headingId}>{data.heading}</h2>
  ) : (
    <h2 class="demo-visually-hidden" id={headingId}>{t('features.fallbackHeading')}</h2>
  )}

  <ul class="demo-features__list" role="list">
    {data.items?.map((item) => (
      <li class="demo-features__item">
        <h3 class="demo-features__title">{item.title}</h3>
        {item.text && <p class="demo-features__text">{item.text}</p>}
      </li>
    ))}
  </ul>
</section>

<style>
  .demo-features {
    width: 100%;
    max-width: var(--demo-container);
    margin-inline: auto;
    padding-inline: var(--demo-space-4);
    padding-block: var(--demo-space-16);
    background: var(--demo-color-surface);
  }

  .demo-features__heading {
    font-size: var(--demo-text-xl);
    margin-bottom: var(--demo-space-8);
  }

  .demo-features__list {
    display: grid;
    gap: var(--demo-space-6);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .demo-features__item {
    background: var(--demo-color-bg);
    border: 1px solid var(--demo-color-border);
    border-radius: var(--demo-radius);
    padding: var(--demo-space-6);
  }

  .demo-features__title {
    font-size: var(--demo-text-lg);
    margin-bottom: var(--demo-space-2);
  }

  .demo-features__text {
    color: var(--demo-color-text-muted);
  }
</style>