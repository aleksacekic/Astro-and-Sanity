---
import type {FaqSection} from '../lib/types'
const {data} = Astro.props as {data: FaqSection}
---

<section class="demo-faq" aria-labelledby={`faq-${data._key}`}>
  {data.heading && (
    <h2 class="demo-faq__heading" id={`faq-${data._key}`}>{data.heading}</h2>
  )}

  <div class="demo-faq__list">
    {data.questions?.map((qa) => (
      <details class="demo-faq__item" name={`faq-${data._key}`}>
        <summary class="demo-faq__question">{qa.question}</summary>
        <div class="demo-faq__answer"><p>{qa.answer}</p></div>
      </details>
    ))}
  </div>
</section>

<style>
  .demo-faq {
    width: 100%;
    max-width: 48rem;          /* uži od ostalih: tekst za čitanje */
    margin-inline: auto;
    padding-inline: var(--demo-space-4);
    padding-block: var(--demo-space-16);
  }

  .demo-faq__heading {
    font-size: var(--demo-text-xl);
    margin-bottom: var(--demo-space-8);
  }

  .demo-faq__item {
    border-bottom: 1px solid var(--demo-color-border);
  }

  .demo-faq__question {
    cursor: pointer;
    padding: var(--demo-space-4) 0;
    font-size: var(--demo-text-lg);
    font-weight: 600;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--demo-space-4);
    list-style: none;          /* uklanja podrazumevani trougao */
    min-height: 44px;
  }

  .demo-faq__question::-webkit-details-marker { display: none; }

  /* Sopstvena strelica */
  .demo-faq__question::after {
    content: "";
    flex-shrink: 0;
    width: 0.6em;
    height: 0.6em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform var(--demo-transition);
  }

  .demo-faq__item[open] .demo-faq__question::after {
    transform: rotate(-135deg);
  }

  .demo-faq__answer {
    padding-bottom: var(--demo-space-4);
    color: var(--demo-color-text-muted);
    max-width: var(--demo-measure);
  }
</style>