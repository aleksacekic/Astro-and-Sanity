---
import type {HeroSection} from '../lib/types'
const {data} = Astro.props as {data: HeroSection}
---

<section class="demo-hero">
  <div class="demo-hero__content">
    <h1 class="demo-hero__heading">{data.heading}</h1>
    {data.subheading && <p class="demo-hero__subheading">{data.subheading}</p>}
    {data.ctaLabel && data.ctaHref && (
      <a class="demo-button" href={data.ctaHref}>{data.ctaLabel}</a>
    )}
  </div>

  {data.image?.url && (
    <img
      class="demo-hero__image"
      src={`${data.image.url}?w=1200&auto=format`}
      alt={data.image.alt ?? ''}
      width={data.image.width}
      height={data.image.height}
      fetchpriority="high"
    />
  )}
</section>

<style>
  .demo-hero {
    display: grid;
    gap: var(--demo-space-8);
    padding-block: var(--demo-space-16);
    width: 100%;
    max-width: var(--demo-container);
    margin-inline: auto;
    padding-inline: var(--demo-space-4);
  }

  .demo-hero__heading {
    font-size: var(--demo-text-2xl);
    margin-bottom: var(--demo-space-4);
  }

  .demo-hero__subheading {
    font-size: var(--demo-text-lg);
    color: var(--demo-color-text-muted);
    max-width: var(--demo-measure);
    margin-bottom: var(--demo-space-8);
  }

  .demo-hero__image {
    border-radius: var(--demo-radius-lg);
    width: 100%;
  }

  /* Dve kolone tek kad ima mesta */
  @media (min-width: 48em) {
    .demo-hero {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--demo-space-12);
      padding-block: var(--demo-space-24);
    }
  }
</style>